# Copy to .env and adjust. docker-compose.yml reads these automatically.
# .env is gitignored — never commit tokens.
#
# The default GIT_URL is the PUBLIC GitHub mirror (Gitea -> GitHub), so no token
# is needed. Only set GIT_TOKEN if you point GIT_URL back at the private Gitea.

# Clone URL for the app repo (must be reachable from inside the containers).
GIT_URL=https://github.com/rafaelmuylaert/buraco.git

# Branch/tag to track.
GIT_REF=main

# Optional: Gitea token, only needed when GIT_URL points at the private repo.
# Create one: Gitea UI -> Settings -> Applications -> Generate New Token.
GIT_TOKEN=

# Poll interval in seconds; 0 = pull once at start, no auto-update.
GIT_POLL_SECS=60
